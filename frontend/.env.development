# =====================================================================
#  开发环境配置（可提交，不含任何密钥）
#  所有 VITE_ 变量都在「启动/构建时」读取，改完需重启 dev server。
# =====================================================================

VITE_APP_TITLE=智能 AI 校园外卖平台

# 后端接口前缀。
# 默认 /api 表示「同源相对路径」，由 vite.config.ts 的代理转发到后端，
# 因此前后端在同一台机器时无需关心后端 IP，换电脑也不用改。
VITE_API_BASE_URL=/api

# WebSocket 端点。
# 留空即可：前端会自动用「当前页面的 host」拼出 ws://<你访问的地址>/api/ws/order，
# 这样本机用 localhost、同事用局域网 IP 访问都能连上。
# 仅当前端与后端不同源（例如后端部署在另一台服务器）才需要显式指定，例如：
#   VITE_WS_URL=ws://192.168.1.100:8080/api/ws/order
VITE_WS_URL=
