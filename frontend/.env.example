# =====================================================================
#  .env.example  —— 前端环境变量模板
#
#  用法：
#      copy .env.example .env.local        # 本机私密覆盖（已被 .gitignore 忽略）
#   或 copy .env.example .env.production   # 生产/演示构建配置
#
#  Vite 的加载优先级（后者覆盖前者）：
#      .env  <  .env.[mode]  <  .env.[mode].local
#  修改后必须重启 dev server 或重新 build 才生效。
# =====================================================================

VITE_APP_TITLE=智能 AI 校园外卖平台

# 后端接口前缀，默认同源 /api（由 vite.config.ts 代理到 BACKEND_ORIGIN）
# 若前端与后端不同源，改成完整地址，例如 http://192.168.1.100:8080/api
VITE_API_BASE_URL=/api

# WebSocket 端点，留空则自动按当前访问地址推导
# 跨域时才需要显式指定，例如 ws://192.168.1.100:8080/api/ws/order
VITE_WS_URL=
