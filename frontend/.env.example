# =====================================================================
#  .env.example  —— 前端环境变量模板
#
#  用法：
#      copy .env.example .env.local        # 本机私密覆盖（已被 .gitignore 忽略）
#   或 copy .env.example .env.production   # 生产/演示构建配置
#
#  Vite 的加载优先级（后者覆盖前者）：
#      .env  <  .env.[mode]  <  .env.[mode].local
#  修改后必须重启 dev server 或重新 build 才生效。
# =====================================================================

VITE_APP_TITLE=智能 AI 校园外卖平台

# 后端接口前缀，默认同源 /api（由 vite.config.ts 代理到 BACKEND_ORIGIN）
# 若前端与后端不同源，改成完整地址，例如 http://192.168.1.100:8080/api
VITE_API_BASE_URL=/api

# WebSocket 端点，留空则自动按当前访问地址推导
# 跨域时才需要显式指定，例如 ws://192.168.1.100:8080/api/ws/order
VITE_WS_URL=

# ---------------------------------------------------------------------
#  登录页「扫码登录」本地演示开关（后端未接入扫码登录前使用）
# ---------------------------------------------------------------------
# 是否显示「模拟手机扫码 / 模拟手机确认」按钮：
#   true  → 始终显示（打包后的演示页面也能用）
#   false → 始终隐藏
#   留空  → 仅 npm run dev 时显示
# VITE_LOGIN_QR_DEMO=true

# 扫码确认后用于登录的演示账号（必填才会真的登录）。
# 注意：只写在本机 .env.local（已被 .gitignore 忽略），不要提交到仓库，
#      也不要把真实账号口令写进这里以外的任何前端文件。
# VITE_LOGIN_QR_DEMO_ACCOUNT=20210001
# VITE_LOGIN_QR_DEMO_PASSWORD=你的本地演示口令

# ---------------------------------------------------------------------
#  登录页「短信登录」本地演示开关（未接入短信网关前使用）
# ---------------------------------------------------------------------
# 是否展示本地生成的 6 位验证码与说明：true / false / 留空（仅 dev 显示）
# VITE_LOGIN_SMS_DEMO=true

# 短信验证码校验通过后，用哪个演示账号换取 JWT（只写在本机 .env.local）
# VITE_LOGIN_SMS_DEMO_ACCOUNT=20210001
# VITE_LOGIN_SMS_DEMO_PASSWORD=你的本地演示口令
