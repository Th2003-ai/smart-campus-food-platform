# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
*.log
!.mvn/wrapper/maven-wrapper.jar

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
# 忽略 .vscode 下的个人配置，但保留 settings.json（工作区设置）
# 和 extensions.json（扩展推荐）供全组共用
# 注意：必须写成 .vscode/* 才能放行里面的文件——如果写成 .vscode/，
# git 不会进入这个目录，下面的 ! 例外规则会失效
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# ---------- Node / Vue ----------
node_modules/
dist/
dist-ssr/
.pnpm-store/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 运行时与本地配置 ----------
# 本地私密配置（数据库密码、大模型 API Key 等）不得提交
application-local.yml
application-local.yaml
.env.local
.env.*.local
logs/
temp/

# ---------- 上传文件与缓存 ----------
uploads/
*.tmp
*.bak

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
