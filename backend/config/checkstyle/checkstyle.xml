<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  智能 AI 校园外卖平台 · 后端 Java 代码规范检查规则（第 8 组）

  怎么用（IDEA）：
    设置 → 工具 → Checkstyle → 点「+」→ 选本文件 → 确定 → 在列表里勾上启用
    然后底部 Checkstyle 面板点「Check Project」，或某个文件右键「Check Current File」

  设计原则：
  1. 所有规则 severity 都是 warning —— 只提示、不判失败，不会卡住编译和运行。
  2. 只查「一眼能改」的问题：命名、没用到的 import、能简化的表达式、空语句、行尾空格。
  3. 缩进 / 换行 / 编码交给仓库根目录的 .editorconfig（IDEA 原生支持），这里不重复管。
  4. 全部是通用 Java 规范，不掺业务判断，误报少、改动成本低。
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <!-- ================= 文件级 ================= -->
  <!-- 文件末尾要有换行 -->
  <module name="NewlineAtEndOfFile"/>
  <!-- 不允许用 Tab 缩进，统一空格 -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>
  <!-- 行尾不允许有多余空格 -->
  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="message" value="行尾有多余空格或制表符，请删除"/>
  </module>
  <!-- 单行最长 160 字符（package / import 行不查） -->
  <module name="LineLength">
    <property name="max" value="160"/>
    <property name="ignorePattern" value="^package.*|^import.*"/>
  </module>

  <module name="TreeWalker">

    <!-- ================= 命名规范 ================= -->
    <!-- 包名小写：com.campus.delivery.xxx -->
    <module name="PackageName"/>
    <!-- 类名大驼峰：MerchantDishController -->
    <module name="TypeName"/>
    <!-- 方法名小驼峰：getDetail -->
    <module name="MethodName"/>
    <!-- 成员变量小驼峰：shopId -->
    <module name="MemberName"/>
    <!-- 局部变量小驼峰 -->
    <module name="LocalVariableName"/>
    <!-- 方法参数小驼峰 -->
    <module name="ParameterName"/>
    <!-- 常量全大写下划线：CODE_STOCK_NOT_ENOUGH -->
    <module name="ConstantName"/>
    <!-- 修饰符顺序：public static final，不能写 final public static -->
    <module name="ModifierOrder"/>

    <!-- ================= import 规范 ================= -->
    <!-- 导入了但没用到的类 -->
    <module name="UnusedImports"/>
    <!-- 重复导入 -->
    <module name="RedundantImport"/>
    <!-- 禁止 import xxx.*，要写具体类名 -->
    <module name="AvoidStarImport"/>

    <!-- ================= 语句与表达式 ================= -->
    <!-- 多余的分号：int a = 1;; -->
    <module name="EmptyStatement"/>
    <!-- 重写了 equals 就必须重写 hashCode，反之亦然 -->
    <module name="EqualsHashCode"/>
    <!-- 能简化的布尔表达式：if (x == true) -->
    <module name="SimplifyBooleanExpression"/>
    <!-- 能简化的布尔返回：if (x) return true; else return false; -->
    <module name="SimplifyBooleanReturn"/>
    <!-- 字符串比较必须用 equals，不能用 == -->
    <module name="StringLiteralEquality"/>
    <!-- long 字面量要用大写 L，不用小写 l -->
    <module name="UpperEll"/>

  </module>
</module>
