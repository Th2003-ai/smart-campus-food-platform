# 统一使用 LF 换行，避免 Windows / macOS 协作时整文件差异
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.ts     text eol=lf
*.vue    text eol=lf
*.json   text eol=lf
*.html   text eol=lf

# 二进制文件不做换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.docx   binary
*.xlsx   binary
*.pdf    binary

# 语言统计时把前端目录识别为 JS/TS 而非文档
*.vue    linguist-language=Vue
